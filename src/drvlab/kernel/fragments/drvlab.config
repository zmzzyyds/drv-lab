# drv-lab's guest kernel fragment, merged on top of defconfig + virtconfig.
#
# virtconfig strips the SoC ARCH_* options and nothing else. Everything below is
# what a guest needs in order to boot a busybox initramfs, mount a 9p share and
# load a module — and nothing beyond it.
#
# KNOWN COST, carried deliberately for now: DRM, SOUND, INFINIBAND and the
# per-vendor network drivers are not disabled here. A guest never uses them, and
# nouveau alone takes a noticeable slice of a full build on two cores. They are
# left alone because changing this file changes the cache key, and the tree that
# is already built was built without those disables. Disabling them is the first
# change to make once that cost can be paid.

# Modules, because the driver under test is one.
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y

# Device nodes come from devtmpfs: there is no udev in a busybox initramfs.
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# The host shares a directory with the guest over 9p, carried on a PCI virtio
# device. PCI rather than virtio-mmio on purpose: it survives the guest being
# given a device tree.
CONFIG_PCI=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_NET_9P=y
CONFIG_9P_FS=y
CONFIG_NET_9P_VIRTIO=y

# Off on purpose. Debug info costs gigabytes, and the harness reads the console,
# not a debugger. Note this has to be done through the choice, not by clearing
# CONFIG_DEBUG_INFO on its own -- olddefconfig re-selects it otherwise.
# CONFIG_DEBUG_INFO is not set
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT is not set
